<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.alshifaspecializedhospital.AppointmentBookingController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <Label text="نظام حجز المواعيد" textFill="#2b5e2b">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="رقم الهوية:" GridPane.rowIndex="0" />
                <TextField fx:id="txtPatientId" promptText="أدخل رقم الهوية" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="اسم المريض:" GridPane.rowIndex="1" />
                <TextField fx:id="txtPatientName" promptText="أدخل الاسم الرباعي" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="رقم الجوال:" GridPane.rowIndex="2" />
                <TextField fx:id="txtPatientPhone" promptText="أدخل رقم الجوال" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="العمر:" GridPane.rowIndex="3" />
                <TextField fx:id="txtPatientAge" promptText="أدخل العمر" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="الأعراض / الشكوى:" GridPane.rowIndex="4" />
                <TextField fx:id="txtSymptoms" promptText="وصف الأعراض الطبية" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="اختيار الطبيب:" GridPane.rowIndex="5" />
                <ComboBox fx:id="cmbDoctors" prefWidth="250.0" promptText="اختر الطبيب المعالج" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="تاريخ الموعد:" GridPane.rowIndex="6" />
                <DatePicker fx:id="dpAppointmentDate" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                <Label text="وقت الموعد (HH:mm):" GridPane.rowIndex="7" />
                <TextField fx:id="txtAppointmentTime" promptText="مثال 10:30" GridPane.columnIndex="1" GridPane.rowIndex="7" />
            </children>
        </GridPane>

        <HBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="10.0" />
            </padding>
            <children>
                <Button fx:id="btnBook" mnemonicParsing="false" onAction="#handleBookAppointment" style="-fx-background-color: #229E99;" text="حجز الموعد" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="btnViewAppointments" mnemonicParsing="false" onAction="#handleViewAppointments" style="-fx-background-color: #2b5e2b;" text="عرض المواعيد المحجوزة" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
